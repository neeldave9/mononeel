---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { SITE } from "@consts";
import { FEATURES, NAV_FEATURE_ORDER } from "@config/features";

const enabledNavItems = NAV_FEATURE_ORDER
  .map((key) => ({ key, feature: FEATURES[key] }))
  .filter(({ feature }) => feature.enabled);
---

<header>
  <Container>
    <div class="flex flex-wrap gap-y-2 justify-between">
      <Link href="/" underline={false}>
        <div class="font-semibold">
          {SITE.NAME}
        </div>
      </Link>
      <nav class="flex gap-1">
        {
          enabledNavItems.map(({ feature }, index) => (
            <>
              <Link href={feature.routePrefix}>
                {feature.navLabel}
              </Link>
              {index < enabledNavItems.length - 1 && (
                <span>
                  {`/`}
                </span>
              )}
            </>
          ))
        }
      </nav>
    </div>
  </Container>
</header>

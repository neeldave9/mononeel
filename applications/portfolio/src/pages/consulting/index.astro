---
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { SITE } from "@consts";
import { isFeatureEnabled } from "@config/features";

if (!isFeatureEnabled("consulting")) {
  return Astro.redirect("/404");
}
---

<PageLayout
  title="Consulting"
  description="Freelance consulting to build web applications for businesses, from simple marketing pages to systems that reduce manual work."
>
  <Container>
    <div class="space-y-10">
      <div class="animate font-semibold text-black dark:text-white">
        Consulting
      </div>

      <section class="animate space-y-4">
        <p>
          I'm open to creating web applications for businesses—ranging from
          simple pages to promote your business, all the way to complex systems
          that reduce manual work.
        </p>
        <p>
          My goal is to help you solve real problems: understand what's
          currently hard, define the right outcome, then build a solution that
          stays maintainable as you grow.
        </p>
      </section>

      <section class="animate space-y-3">
        <div class="font-semibold text-black dark:text-white">
          What I can build
        </div>
        <ul class="flex flex-col gap-2">
          <li>Marketing / landing pages</li>
          <li>Business websites with CMS-like content updates</li>
          <li>Internal tools that automate repetitive tasks</li>
          <li>Dashboards, workflows, and reporting</li>
          <li>Integrations that connect your systems</li>
        </ul>
      </section>

      <section class="animate space-y-3">
        <div class="font-semibold text-black dark:text-white">
          How we work together
        </div>
        <ul class="flex flex-col gap-2">
          <li>Problem-first discovery to clarify scope and success metrics</li>
          <li>Simple plan + milestones so you know what's next</li>
          <li>Build, iterate, and deliver with clean handoff</li>
        </ul>
      </section>

      <section class="animate space-y-4">
        <div class="font-semibold text-black dark:text-white">Let's talk</div>
        <p>
          If you have a project in mind—big or small—send me a quick note and
          I'll get back to you. Include what you're trying to achieve and any
          deadlines.
        </p>

        <p>
          I like to keep things low-risk: we’ll start by building a small,
          working MVP so you can see real progress early. You only commit once
          you're confident in the direction and happy with the outcome.
        </p>

        <p>
          Most of the projects I take on are also an opportunity for me to go
          deep on interesting problems, so I'm invested in building something
          thoughtful and high-quality—not just shipping quickly.
        </p>

        <p>
          <Link href={`mailto:${SITE.EMAIL}`} aria-label={`Email ${SITE.NAME}`}>
            Email me: {SITE.EMAIL}
          </Link>
        </p>
      </section>
    </div>
  </Container>
</PageLayout>
